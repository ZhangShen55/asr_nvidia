+def test_snapshot_exposes_each_owner_budget_and_failure(experiment,monkeypatch):
+    c=client(experiment)
+    for index,runtime in enumerate(c._runtimes):
+        def snapshot(n=index):return dict(loaded=True,loading=False,failure='dead'if n==experiment.count-1 else None,
+            memory_allocated_mb=n+1,memory_reserved_mb=n+2,
+            continuous={'phase_wall_s':{'prefill':n+3}},
+            model_worker={'worker_pid':1000+n,'worker_allocator':{'worker_pid':1000+n}})
+        runtime.snapshot=snapshot
