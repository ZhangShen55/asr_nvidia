@@ -0,0 +1,201 @@
+"""Only CPU fake owners: explicit six/eight capacity experiment wiring."""
+import asyncio
+from concurrent.futures import Future
+import json
+from pathlib import Path
+from types import SimpleNamespace
+import pytest
+import tomli
+
+from core import qwen_asr_client as mod
+from core.config import Settings
+
+
+@pytest.fixture(params=[6,8])
+def experiment(request,monkeypatch,tmp_path):
+    count=request.param
+    cfg=Path(__file__).resolve().parents[1]/f'test/config.qwen200-m{count}.toml'
+    monkeypatch.setattr(mod.settings,'_cfg',tomli.loads(cfg.read_text()))
+    rows=[{'sha256':('%020x'%(i+1))+('%044x'%(i+1))}for i in range(8)]
+    manifest=tmp_path/'inputs.json';manifest.write_text(json.dumps(rows))
+    monkeypatch.setenv('QWEN200_EXPERIMENT_WORKERS',str(count))
+    monkeypatch.setenv('QWEN200_ROUTING_MANIFEST',str(manifest))
+    monkeypatch.delenv('QWEN200_EXPERIMENT_M2',raising=False)
+    monkeypatch.delenv('QWEN200_STARTUP_STOP_FILE',raising=False)
+    return SimpleNamespace(count=count,rows=rows,cfg=cfg)
+
+
+def rid(exp,index):return 'uuid_audio-'+exp.rows[index]['sha256'][:20]+'.wav'
+
+
+class FakeRuntime:
+    def __init__(self,*a,**kw):
+        self.loaded=False;self.failure=None;self.calls=[];self.pending={};self.closed=False;self.begin=False
+    def ensure_loaded(self):self.loaded=True
+    def submit(self,audio,language,*,request_id,segment_id):
+        self.calls.append(('submit',request_id,segment_id))
+        return self.pending.setdefault((request_id,str(segment_id)),Future())
+    def cancel_segment(self,request_id,segment_id):
+        self.calls.append(('cancel',request_id,segment_id))
+        future=self.pending[(request_id,str(segment_id))]
+        if not future.done():future.set_exception(RuntimeError('cancelled by owner'))
+    def release_request(self,request_id):
+        keys=[k for k in self.pending if k[0]==request_id]
+        if any(not self.pending[k].done()for k in keys):raise RuntimeError('active')
+        self.calls.append(('release',request_id))
+        for k in keys:self.pending.pop(k)
+    def begin_closing(self):self.begin=True
+    def close(self):self.closed=True
+    def snapshot(self):return dict(loaded=self.loaded,loading=False,failure=self.failure,
+        memory_allocated_mb=0,memory_reserved_mb=0,model_worker={'worker_pid':None})
+
+
+def client(exp,factory=FakeRuntime):
+    return mod.QwenAsrClient(local_instance_count=exp.count,generation_mode='continuous',
+        execution_mode='process',runtime_factory=factory)
+
+
+def member(request_id):return SimpleNamespace(request_id=request_id,segment_index='0',
+    cancelled=False,audio=b'private-pcm',language=None)
+
+
+def test_exact_audio_share_budgets_per_constructor(experiment,monkeypatch):
+    from core import qwen_continuous_process as process
+    options=[]
+    def capture(*a,**kw):options.append(kw);return FakeRuntime()
+    monkeypatch.setattr(process,'LocalQwenContinuousProcessRuntime',capture)
+    c=mod.QwenAsrClient(local_instance_count=experiment.count,generation_mode='continuous',execution_mode='process')
+    shares=[sum(i%experiment.count==n for i in range(8))for n in range(experiment.count)]
+    assert shares==([2,2,1,1,1,1]if experiment.count==6 else [1]*8)
+    assert len(options)==experiment.count
+    for n,(option,share)in enumerate(zip(options,shares)):
+        assert option['max_active']==option['max_batch_size']==16*share
+        assert option['prefill_batch_size']==16
+        assert option['max_batch_tokens']==10000*share
+        assert option['max_batch_audio_frames']==14400*share
+        assert c._experiment_worker_budgets[n]['audio_count']==share
+    assert sum(o['max_active']for o in options)==128
+    assert sum(o['max_batch_tokens']for o in options)==80000
+    assert sum(o['max_batch_audio_frames']for o in options)==115200
+
+
+def test_route_is_fixed_by_source_and_unknown_fails(experiment):
+    c=client(experiment)
+    for index in [7,3,6,2,0,5,4,1]:
+        assert c._continuous_worker_index(rid(experiment,index))==index%experiment.count
+    assert [sum(v==n for v in c._continuous_routes.values())for n in range(experiment.count)]==([2,2,1,1,1,1]if experiment.count==6 else [1]*8)
+    with pytest.raises(ValueError,match='exactly one'):c._continuous_worker_index('ordinary-warmup.wav')
+    with pytest.raises(ValueError,match='exactly one'):c._continuous_worker_index(rid(experiment,0)+rid(experiment,1))
+    assert all(not r.calls for r in c._runtimes)
+
+
+def test_explicit_gate_matches_configured_six_or_eight(experiment,monkeypatch):
+    settings=Settings(str(experiment.cfg));settings.validate_model_backends()
+    monkeypatch.delenv('QWEN200_EXPERIMENT_WORKERS')
+    with pytest.raises(ValueError,match='单Qwen'):settings.validate_model_backends()
+    with pytest.raises(ValueError,match='one process'):client(experiment)
+    monkeypatch.setenv('QWEN200_EXPERIMENT_WORKERS','8'if experiment.count==6 else'6')
+    with pytest.raises(ValueError,match='单Qwen'):settings.validate_model_backends()
+    with pytest.raises(ValueError,match='one process'):client(experiment)
+    monkeypatch.setenv('QWEN200_EXPERIMENT_WORKERS','4');settings._cfg['qwen_asr']['local_instance_count']=4
+    with pytest.raises(ValueError,match='单Qwen'):settings.validate_model_backends()
+
+
+def test_budgets_must_partition_by_eight_sources(experiment,monkeypatch):
+    cfg=dict(mod.settings._cfg);cfg['qwen_asr']=dict(cfg['qwen_asr'],max_batch_tokens=80001)
+    monkeypatch.setattr(mod.settings,'_cfg',cfg)
+    with pytest.raises(ValueError,match='eight audio shares'):client(experiment)
+
+
+def test_all_workers_preload_in_sequence_and_close(experiment):
+    async def scenario():
+        order=[]
+        class Runtime(FakeRuntime):
+            def ensure_loaded(self):order.append(self);self.loaded=True
+        c=client(experiment,Runtime)
+        await c.preload();assert order==c._runtimes
+        await c.aclose();assert all(r.closed and r.begin for r in c._runtimes)
+        assert c._shutdown_state['phase']=='closed'
+    asyncio.run(scenario())
+
+
+def test_partial_preload_failure_does_not_load_later_owners_and_closes_all(experiment):
+    async def scenario():
+        order=[];created=[]
+        class Runtime(FakeRuntime):
+            def __init__(self,*a):super().__init__();created.append(self)
+            def ensure_loaded(self):
+                order.append(self)
+                if self is created[2]:self.failure='load failed';raise RuntimeError('load failed')
+                self.loaded=True
+        c=client(experiment,Runtime)
+        with pytest.raises(mod.QwenAsrUnavailableError):await c.preload()
+        assert order==created[:3]
+        await c.aclose();assert all(r.closed for r in created)
+    asyncio.run(scenario())
+
+
+@pytest.mark.parametrize('after_count',[0,1,3])
+def test_startup_stop_file_before_or_after_owner_stops_later_loads(experiment,monkeypatch,tmp_path,after_count):
+    async def scenario():
+        order=[];stop=tmp_path/'startup-stop'
+        monkeypatch.setenv('QWEN200_STARTUP_STOP_FILE',str(stop))
+        if after_count==0:stop.touch()
+        class Runtime(FakeRuntime):
+            def ensure_loaded(self):
+                order.append(self);self.loaded=True
+                if len(order)==after_count:stop.touch()
+        c=client(experiment,Runtime)
+        with pytest.raises(mod.QwenAsrUnavailableError,match='startup stop'):await c.preload()
+        assert order==c._runtimes[:after_count]
+        await c.aclose();assert all(r.closed for r in c._runtimes)
+    asyncio.run(scenario())
+
+
+def test_failed_selected_owner_never_migrates(experiment):
+    async def scenario():
+        c=client(experiment);await c.preload()
+        index=experiment.count-1;c._runtimes[index].failure='dead owner'
+        with pytest.raises(mod.QwenAsrUnavailableError):await c._execute_sequence(member(rid(experiment,index)))
+        assert all(not r.calls for r in c._runtimes)
+        assert c._continuous_worker_index(rid(experiment,index))==index
+        await c.aclose()
+    asyncio.run(scenario())
+
+
+def test_selected_cancel_and_release_keep_owned_future(experiment):
+    async def scenario():
+        c=client(experiment);await c.preload();index=experiment.count-1;request_id=rid(experiment,index)
+        task=asyncio.create_task(c._execute_sequence(member(request_id)))
+        for _ in range(100):
+            if c._runtimes[index].pending:break
+            await asyncio.sleep(.001)
+        with pytest.raises(RuntimeError,match='active'):c.release_request(request_id)
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):await task
+        assert c._runtimes[index].pending[(request_id,'0')].done()
+        c.release_request(request_id)
+        assert request_id not in c._continuous_routes
+        assert all(not r.calls for n,r in enumerate(c._runtimes)if n!=index)
+        await c.aclose()
+    asyncio.run(scenario())
+
