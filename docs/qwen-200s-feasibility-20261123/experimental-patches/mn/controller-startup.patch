+"""启动未ready期间的只读资源闸门及合作中止，不启动任何NPU。"""
+import argparse
+import asyncio
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+import time
+from types import SimpleNamespace
+import pytest
+
+ROOT=Path(__file__).resolve().parents[1]
+spec=importlib.util.spec_from_file_location('qwen200_startup_controller',ROOT/'scripts/benchmark_qwen200.py')
+mod=importlib.util.module_from_spec(spec);spec.loader.exec_module(mod)
+
+
+def args(**changes):
+    data=dict(url='http://127.0.0.1:18083',startup_timeout_s=1,startup_resource_interval_s=.01)
+    data.update(changes);return argparse.Namespace(**data)
+
+
+class Owner:
+    def __init__(self,path,code=None):
+        self.startup_stop_path=str(path/'stop.json');self.process=SimpleNamespace(poll=lambda:code)
+        self.expected_exit_codes=(0,);self.registrations=0
+    def register(self):self.registrations+=1
+
+
+async def not_ready():return None
+
+
+def test_startup_low_hbm_triggers_before_http_ready_and_requests_cooperative_stop(tmp_path):
+    owner=Owner(tmp_path)
+    with pytest.raises(mod.StartupResourceAbort) as caught:
+        asyncio.run(mod.wait_for_startup(args(),owner,tmp_path,probe_fn=lambda:dict(available=True,card=7,free_hbm_mb=7000),status_fn=not_ready))
+    assert caught.value.trigger['reason']=='startup_resource_hbm_free'
+    assert owner.expected_startup_abort and owner.expected_exit_codes==(0,3)
+    assert json.loads(Path(owner.startup_stop_path).read_text())['reason']=='startup_resource_hbm_free'
+    row=json.loads((tmp_path/'startup-resource.jsonl').read_text().splitlines()[0])
+    assert row['unit'].startswith('MiB') and row['card']==7
+
+
+def test_partial_sequential_preload_is_monitored_between_samples(tmp_path):
+    owner=Owner(tmp_path);values=iter([40000,7100])
+    def probe():return dict(available=True,card=7,free_hbm_mb=next(values))
+    with pytest.raises(mod.StartupResourceAbort):
+        asyncio.run(mod.wait_for_startup(args(),owner,tmp_path,probe_fn=probe,status_fn=not_ready))
+    rows=[json.loads(v) for v in (tmp_path/'startup-resource.jsonl').read_text().splitlines()]
+    assert len(rows)==2 and rows[0]['free_hbm_mb']==40000 and rows[1]['free_hbm_mb']==7100
+    assert owner.registrations>=3
+
+
+def test_http_ready_still_requires_a_final_fresh_probe(tmp_path):
+    owner=Owner(tmp_path);values=iter([40000,7000])
+    async def ready():return {'ready':True}
+    with pytest.raises(mod.StartupResourceAbort):
+        asyncio.run(mod.wait_for_startup(args(),owner,tmp_path,probe_fn=lambda:dict(available=True,card=7,free_hbm_mb=next(values)),status_fn=ready))
+    assert not (tmp_path/'initial-status.json').exists()
+
+
+def test_startup_unobservable_fails_closed_without_accepting_exit3(tmp_path):
+    owner=Owner(tmp_path)
+    with pytest.raises(mod.StartupResourceAbort) as caught:
+        asyncio.run(mod.wait_for_startup(args(),owner,tmp_path,probe_fn=lambda:dict(available=False,card=7,reason='probe failed'),status_fn=not_ready))
+    assert caught.value.trigger['reason']=='startup_resource_unobservable'
+    assert owner.expected_exit_codes==(0,) and not getattr(owner,'expected_startup_abort',False)
+
+
+def test_unexpected_startup_process_error_not_laundered_as_expected_abort(tmp_path):
+    owner=Owner(tmp_path,code=3)
+    with pytest.raises(RuntimeError,match='启动失败'):
+        asyncio.run(mod.wait_for_startup(args(),owner,tmp_path,probe_fn=lambda:dict(available=True,card=7,free_hbm_mb=30000),status_fn=not_ready))
+    assert Path(owner.startup_stop_path).exists() and owner.expected_exit_codes==(0,)
+
+
+def test_probe_only_card7_parser_does_not_import_torch_or_initialize_device(monkeypatch):
+    import core.resource_diagnostics as diagnostics
+    monkeypatch.setattr(diagnostics,'npu_snapshot',lambda:dict(available=True,npus=[
+        dict(index=0,available=True,hbm_free_mb=1),dict(index=7,available=True,hbm_free_mb=30000)]))
+    before=set(sys.modules)
+    result=mod.readonly_card7_probe()
+    assert result['available'] and result['free_hbm_mb']==30000
+    assert not ({'torch','torch_npu'} & (set(sys.modules)-before))
+
+
+def test_startup_red_execute_finally_reaps_even_without_formal_requests(monkeypatch,tmp_path):
+    state={}
+    class ChildOwner(Owner):
+        def __init__(self,*a,**kw):super().__init__(tmp_path);state['owner']=self
+        async def close(self,*a):
+            state['closed']=True
+            return dict(passed=True,exit_code=3,expected_startup_abort=True,normal_exit0=False)
+    monkeypatch.setattr(mod,'OwnedService',ChildOwner)
+    monkeypatch.setattr(mod,'readonly_card7_probe',lambda:dict(available=True,card=7,free_hbm_mb=7000))
+    a=args(launch_service=True,config='config.toml',owned_request_drain_grace_s=30,shutdown_timeout_s=210,observe_s=5)
+    result=asyncio.run(mod.execute(a,[{}]*8,tmp_path))
+    assert state['closed'] and result['status']=='startup_aborted'
+    assert not result['formal_round_started'] and not result['target_passed']
+    assert result['expected_startup_abort'] and result['shutdown']['normal_exit0'] is False
+
+
+def test_owned_close_stopfile_preserves_pid_birth_and_records_normal_exit0(monkeypatch,tmp_path):
+    # 真CPU子进程模拟已加载部分worker的owner；故意放入错误出生身份，不能杀调用方。
+    import psutil
+    monkeypatch.setattr(mod,'listening',lambda *a:False)
+    ready=tmp_path/'child-ready'
+    code="import signal,time,sys;from pathlib import Path;signal.signal(signal.SIGTERM,lambda *_:sys.exit(0));Path(sys.argv[1]).write_text('ready');time.sleep(30)"
+    owner=mod.OwnedService([sys.executable,'-c',code,str(ready)],dict(os.environ),'127.0.0.1',18083,tmp_path)
+    result=None
+    try:
+        deadline=time.monotonic()+5
+        while not ready.exists() and time.monotonic()<deadline:time.sleep(.01)
+        assert ready.exists()
+        own=psutil.Process();owner.identities[own.pid]=own.create_time()-1
+        result=asyncio.run(owner.close(deadline_s=5,observe_s=.02))
+        assert result['passed'] and result['normal_exit0'] and not result['forced']
+        assert Path(owner.startup_stop_path).exists() and psutil.pid_exists(own.pid)
+        assert not result['expected_startup_abort']
+    finally:
+        if owner.remaining():asyncio.run(owner.close(deadline_s=5,observe_s=.02))
+
+
+def test_startup_deadline600_does_not_relax_formal_goal_or_gate():
+    a=mod.parse_args(['--manifest','x','--output','x','--mode','A','--concurrency','8','--startup-timeout-s','600','--expected-qwen-workers','8'])
+    assert a.startup_timeout_s==600 and a.target_s==200 and a.diagnostic_wall_timeout_s==336
