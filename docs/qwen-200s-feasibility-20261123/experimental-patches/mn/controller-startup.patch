+class StartupResourceAbort(RuntimeError):
+    def __init__(self, trigger):
+        self.trigger=trigger
+        super().__init__('startup capacity stopped: '+str(trigger))
+
+
+def request_startup_stop(owner, output, reason):
+    """只写Popen私有目录的合作停止标志，加载中的worker先完成安全边界。"""
+    marker=Path(getattr(owner,'startup_stop_path',Path(output)/'startup-stop.request.json'))
+    if not marker.exists():
+        write_json(marker,dict(reason=reason,utc=utc_now(),monotonic=time.monotonic()))
+    return str(marker)
+
+
+def readonly_card7_probe():
+    # resource_diagnostics是标准库只读模块；不导入torch、不触发NPU初始化。
+    from core.resource_diagnostics import npu_snapshot
+    snapshot=npu_snapshot()
+    card=next((row for row in snapshot.get('npus',[]) if row.get('index')==7),None)
+    return dict(available=bool(snapshot.get('available') and card and card.get('available')),
+                card=7,free_hbm_mb=card.get('hbm_free_mb') if card else None,
+                reason=snapshot.get('reason'),source='OS npu-smi info driver aggregate, no torch/NPU initialization')
+
+
+async def wait_for_startup(args, owner, output, *, probe_fn=None, status_fn=None):
+    """HTTP未ready期间也监控单卡HBM；任何异常均先请求合作停止再由execute finally回收。"""
+    from core.async_utils import await_completion
+    import httpx
+    output=Path(output);probe_fn=probe_fn or readonly_card7_probe
+    interval=getattr(args,'startup_resource_interval_s',2.0)
+    begin=time.monotonic();deadline=begin+args.startup_timeout_s
+    probe_task=status_task=None;probe_started=None;latest_probe=None;ready_status=None;ready_at=None
+    next_probe=begin;next_status=begin
+    async with httpx.AsyncClient(base_url=args.url,trust_env=False,timeout=.5) as client:
+        async def get_status():
+            if status_fn:return await status_fn()
+            try:
+                response=await client.get('/get_status',timeout=.5)
+                return response.json() if response.status_code==200 else None
+            except httpx.HTTPError:return None
+        async def probe():
+            return await await_completion(asyncio.to_thread(probe_fn))
+        try:
+            while True:
+                now=time.monotonic();owner.register()
+                if owner.process.poll() is not None:raise RuntimeError('owned服务启动失败')
+                if probe_task is not None and probe_task.done():
+                    try:row=probe_task.result()
+                    except Exception as exc:row=dict(available=False,card=7,reason=repr(exc))
+                    row=dict(row,monotonic=time.monotonic(),probe_started_monotonic=probe_started,
+                             startup_elapsed_s=time.monotonic()-begin,utc=utc_now(),threshold_hbm_free_mb=8192,
+                             unit='MiB of driver-reported free HBM')
+                    with(output/'startup-resource.jsonl').open('a')as stream:
+                        stream.write(json.dumps(row,ensure_ascii=True)+'\n')
+                    latest_probe=row;probe_task=None;next_probe=probe_started+interval
+                    free=row.get('free_hbm_mb')
+                    if (row.get('available') is not True or row.get('card')!=7 or
+                            not isinstance(free,(int,float)) or not math.isfinite(free)):
+                        trigger=dict(reason='startup_resource_unobservable',observation=row)
+                        write_json(output/'startup-trigger.json',trigger)
+                        raise StartupResourceAbort(trigger)
+                    if free<8192:
+                        trigger=dict(reason='startup_resource_hbm_free',observation=row,
+                                     observed=free,threshold=8192,unit='MiB',card=7)
+                        write_json(output/'startup-trigger.json',trigger)
+                        # 仅明确资源中止可将uvicorn startup exit3归为预期资源回收。
+                        owner.expected_startup_abort=True
+                        owner.startup_abort_reason=trigger['reason']
+                        owner.expected_exit_codes=(0,3)
+                        raise StartupResourceAbort(trigger)
+                if status_task is not None and status_task.done():
+                    value=status_task.result();status_task=None;next_status=now+.5
+                    if value is not None:
+                        ready_status=value;ready_at=time.monotonic()
+                if ready_status is not None and latest_probe is not None and latest_probe['probe_started_monotonic']>=ready_at:
+                    write_json(output/'initial-status.json',ready_status)
+                    return ready_status
+                if now>=deadline:
+                    trigger=dict(reason='startup_timeout',startup_elapsed_s=now-begin,threshold_s=args.startup_timeout_s)
+                    write_json(output/'startup-trigger.json',trigger)
+                    raise StartupResourceAbort(trigger)
+                if probe_task is None and (now>=next_probe or ready_status is not None):
+                    probe_started=time.monotonic();probe_task=asyncio.create_task(probe())
+                if status_task is None and ready_status is None and now>=next_status:
+                    status_task=asyncio.create_task(get_status())
+                await asyncio.sleep(min(.1,max(.001,deadline-time.monotonic())))
+        except BaseException as exc:
+            request_startup_stop(owner,output,getattr(exc,'trigger',{}).get('reason',type(exc).__name__))
+            raise
+        finally:
+            pending=[task for task in (probe_task,status_task) if task is not None]
+            for task in pending:
+                if not task.done():task.cancel()
+            # 只读probe也等有界subprocess/线程退出，重复取消不能遗弃。
+            if pending:await await_completion(asyncio.gather(*pending,return_exceptions=True))
+
