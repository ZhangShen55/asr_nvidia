+++ b/tests/test_qwen200_m2.py
@@ -0,0 +1,268 @@
+"""Isolated M2 wiring contract; every runtime is a CPU fake."""
+import asyncio
+from concurrent.futures import Future
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from core import qwen_asr_client as mod
+from core.config import Settings
+
+
+@pytest.fixture
+def routing(monkeypatch, tmp_path):
+    from pathlib import Path
+    import tomli
+    # Unit tests use the actual candidate's 16/128 profile, not root legacy48/384.
+    cfg=Path(__file__).resolve().parents[1]/'test/config.qwen200-m2.toml'
+    monkeypatch.setattr(mod.settings,'_cfg',tomli.loads(cfg.read_text()))
+    rows = [{'sha256': ('%064x' % (i + 1))[-20:] + ('%044x' % (i + 1)), 'sample_id': 'a'+str(i+1)} for i in range(8)]
+    path = tmp_path/'inputs.json'
+    path.write_text(json.dumps(rows))
+    monkeypatch.setenv('QWEN200_EXPERIMENT_M2', '1')
+    monkeypatch.setenv('QWEN200_ROUTING_MANIFEST', str(path))
+    return rows
+
+
+def request(rows, index, suffix=''):
+    return 'uuid' + suffix + '_audio-' + rows[index]['sha256'][:20] + '.wav'
+
+
+class FakeRuntime:
+    def __init__(self, *args, **kwargs):
+        self.loaded = False
+        self.failure = None
+        self.calls = []
+        self.pending = {}
+        self.closed = False
+        self.begin = False
+    def ensure_loaded(self):
+        self.loaded = True
+    def submit(self, audio, language, *, request_id, segment_id):
+        self.calls.append(('submit', request_id, segment_id))
+        key = (request_id, str(segment_id))
+        if key not in self.pending:
+            self.pending[key] = Future()
+        return self.pending[key]
+    def cancel_segment(self, request_id, segment_id):
+        self.calls.append(('cancel', request_id, segment_id))
+        f = self.pending[(request_id, str(segment_id))]
+        if not f.done():
+            f.set_exception(RuntimeError('backend_cancelled'))
+    def release_request(self, request_id):
+        keys = [k for k in self.pending if k[0] == request_id]
+        if any(not self.pending[k].done() for k in keys):
+            raise RuntimeError('active')
+        self.calls.append(('release', request_id))
+        for key in keys:
+            self.pending.pop(key)
+    def begin_closing(self):
+        self.begin = True
+    def close(self):
+        self.closed = True
+    def snapshot(self):
+        return dict(loaded=self.loaded, loading=False, failure=self.failure,
+                    memory_allocated_mb=0, memory_reserved_mb=0,
+                    model_worker={'worker_pid':None})
+
+
+def client(factory=FakeRuntime, **kwargs):
+    return mod.QwenAsrClient(local_instance_count=2, generation_mode='continuous',
+        execution_mode='process', runtime_factory=factory, **kwargs)
+
+
+def member(rid, segment='0'):
+    return SimpleNamespace(request_id=rid, segment_index=segment, cancelled=False,
+                           audio=b'private-pcm', language=None)
+
+
+def test_m2_requires_explicit_experiment_flag(monkeypatch):
+    monkeypatch.delenv('QWEN200_EXPERIMENT_M2', raising=False)
+    with pytest.raises(ValueError, match='one process'):
+        client()
+
+
+def test_manifest_must_have_eight_distinct_prefixes(routing, monkeypatch, tmp_path):
+    p = tmp_path/'bad.json';p.write_text(json.dumps(routing[:2]))
+    monkeypatch.setenv('QWEN200_ROUTING_MANIFEST',str(p))
+    with pytest.raises(ValueError, match='eight'):
+        client()
+    p.write_text(json.dumps([routing[0]] * 8))
+    with pytest.raises(ValueError, match='duplicate'):
+        client()
+
+
+def test_frozen_mapping_is_independent_of_arrival_and_warmup(routing):
+    c = client()
+    for i in [7, 0, 4, 1, 6, 2, 5, 3]:
+        assert c._continuous_worker_index(request(routing,i,'warmup')) == i % 2
+    for i in range(8):
+        assert c._continuous_worker_index(request(routing,i,'formal')) == i % 2
+    assert len(c._continuous_routes) == 16
+    for rid in list(c._continuous_routes):
+        c.release_request(rid)
+    assert not c._continuous_routes
+
+
+def test_unknown_or_ambiguous_source_never_contacts_a_worker(routing):
+    c = client()
+    for rid in ['warmup.wav',request(routing,0)+request(routing,1)]:
+        with pytest.raises(ValueError, match='exactly one'):
+            asyncio.run(c._execute_sequence(member(rid)))
+    assert not c._continuous_routes
+    assert all(not r.calls for r in c._runtimes)
+    c.release_request('unknown')
+    assert all(not r.calls for r in c._runtimes)
+
+
+def test_budget_is_partitioned_not_copied(routing, monkeypatch):
+    from core import qwen_continuous_process as process
+    options=[]
+    def capture(*args,**kwargs):
+        options.append(kwargs)
+        return FakeRuntime()
+    monkeypatch.setattr(process,'LocalQwenContinuousProcessRuntime',capture)
+    monkeypatch.setattr(mod.settings,'_cfg', {'qwen_asr': {'request_concurrency':128,
+        'max_batch_tokens':80000,'max_batch_audio_frames':115200,
+        'continuous_prefill_batch_size':16, 'max_inference_batch_size':128}})
+    c=mod.QwenAsrClient(local_instance_count=2,generation_mode='continuous',execution_mode='process')
+    assert len(options)==2
+    for option in options:
+        assert option['max_active']==64
+        assert option['max_batch_size']==64
+        assert option['max_batch_tokens']==40000
+        assert option['max_batch_audio_frames']==57600
+        assert option['prefill_batch_size']==16
+    assert c._batch_scheduler.capacity==128
+
+
+def test_uneven_budget_rejected(routing, monkeypatch):
+    monkeypatch.setattr(mod.settings,'_cfg',{'qwen_asr':{'request_concurrency':127}})
+    with pytest.raises(ValueError, match='partition'):
+        client()
+
+
+def test_settings_exception_is_only_opt_in_two_workers(routing, monkeypatch):
+    from pathlib import Path
+    cfg=Path(__file__).resolve().parents[1]/'test/config.qwen200-m2.toml'
+    s=Settings(str(cfg));s.validate_model_backends()
+    monkeypatch.delenv('QWEN200_EXPERIMENT_M2')
+    with pytest.raises(ValueError, match='单Qwen'):
+        s.validate_model_backends()
+    monkeypatch.setenv('QWEN200_EXPERIMENT_M2','1')
+    s._cfg['qwen_asr']['local_instance_count']=3
+    with pytest.raises(ValueError, match='单Qwen'):
+        s.validate_model_backends()
+
+
+def test_preload_sequentially_covers_all_workers_and_close_all(routing):
+    async def scenario():
+        order=[]
+        class Runtime(FakeRuntime):
+            def ensure_loaded(self):
+                order.append(self)
+                self.loaded=True
+        c=client(Runtime)
+        assert await c.preload()
+        assert order==c._runtimes
+        await c.aclose()
+        assert all(r.begin and r.closed for r in c._runtimes)
+        assert c._shutdown_state['phase']=='closed'
+    asyncio.run(scenario())
+
+
+def test_partial_preload_failure_still_closes_every_owned_runtime(routing):
+    async def scenario():
+        created=[]
+        class Runtime(FakeRuntime):
+            def __init__(self,*args):
+                super().__init__();created.append(self)
+            def ensure_loaded(self):
+                if self is created[1]:
+                    self.failure='load failed'
+                    raise RuntimeError(self.failure)
+                self.loaded=True
+        c=client(Runtime)
+        with pytest.raises(mod.QwenAsrUnavailableError):
+            await c.preload()
+        await c.aclose()
+        assert all(r.closed for r in created)
+    asyncio.run(scenario())
+
+
+def test_route_does_not_fail_over_when_selected_worker_dies(routing):
+    async def scenario():
+        c=client();await c.preload()
+        c._runtimes[0].failure='worker died'
+        with pytest.raises(mod.QwenAsrUnavailableError):
+            await c._execute_sequence(member(request(routing,0)))
+        assert not c._runtimes[1].calls
+        assert c._continuous_routes[request(routing,0)]==0
+        await c.aclose()
+    asyncio.run(scenario())
+
+
+def test_normal_completion_and_release_remain_on_selected_owner(routing):
+    async def scenario():
+        c=client();await c.preload();rid=request(routing,1)
+        task=asyncio.create_task(c._execute_sequence(member(rid)))
+        for _ in range(100):
+            if c._runtimes[1].pending:break
+            await asyncio.sleep(.001)
+        c._runtimes[1].pending[(rid,'0')].set_result('language Chinese<asr_text>好。')
+        assert await task=='language Chinese<asr_text>好。'
+        assert c._continuous_active_by_worker==[0,0]
+        c.release_request(rid)
+        assert not c._continuous_routes
+        assert not c._runtimes[0].calls
+        assert c._runtimes[1].calls[-1]==('release',rid)
+        await c.aclose()
+    asyncio.run(scenario())
+
+
+def test_cancel_waits_for_selected_owner_and_cannot_release_active(routing):
+    async def scenario():
+        c=client();await c.preload();rid=request(routing,1)
+        task=asyncio.create_task(c._execute_sequence(member(rid)))
+        for _ in range(100):
+            if c._runtimes[1].pending:break
+            await asyncio.sleep(.001)
+        with pytest.raises(RuntimeError,match='active'):
+            c.release_request(rid)
+        assert rid in c._continuous_routes
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+        assert c._runtimes[1].pending[(rid,'0')].done()
+        assert ('cancel',rid,'0') in c._runtimes[1].calls
+        c.release_request(rid)
+        assert not c._runtimes[0].calls
+        await c.aclose()
+    asyncio.run(scenario())
+
+
+def test_status_exposes_both_cached_workers_and_selected_failure(routing, monkeypatch):
+    c=client()
+    for i,runtime in enumerate(c._runtimes):
+        runtime.loaded=True
+        def snapshot(index=i):
+            return dict(loaded=True,loading=False,failure='dead' if index else None,
+                memory_allocated_mb=100+index,memory_reserved_mb=200+index,
+                continuous={'phase_wall_s':{'prefill':10+index,'decode':20+index}},
+                model_worker={'worker_pid':1000+index,'worker_alive':not bool(index),
+                    'worker_allocator':{'worker_pid':1000+index}})
+        runtime.snapshot=snapshot
+        runtime.ensure_loaded=lambda:pytest.fail('status loaded a worker')
+        runtime.submit=lambda *a,**k:pytest.fail('status sent busy RPC')
+    c._continuous_active_by_worker=[2,0]
+    monkeypatch.setattr(mod,'_client_instance',c)
+    result=mod.get_qwen_status()
+    assert result['configured_model_workers']==2
+    assert result['failed_instances']==1 and result['capacity']==1 and result['loaded']
+    assert [r['worker_pid'] for r in result['model_workers']]==[1000,1001]
+    assert result['instances'][1]['failure']=='dead'
+    assert result['instances'][0]['busy'] and not result['instances'][1]['busy']
+    assert result['instances'][1]['continuous']['phase_wall_s']['decode']==21
+    assert result['memory_allocated_mb']==201
+    assert result['feasibility_experiment']['per_worker_active_limit']==64
