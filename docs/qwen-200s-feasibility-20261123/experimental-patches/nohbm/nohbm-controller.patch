diff --git a/tests/test_qwen200_nohbm.py b/tests/test_qwen200_nohbm.py
new file mode 100644
--- /dev/null
+++ b/tests/test_qwen200_nohbm.py
@@ -0,0 +1,154 @@
+"""显式只停用低HBM阈值，三阶段真实入口的替身契约；不触碰硬件。"""
+import argparse
+import asyncio
+import importlib.util
+import json
+from pathlib import Path
+from types import SimpleNamespace
+import pytest
+from core.qwen200_watchdog import Qwen200Watchdog
+
+ROOT=Path(__file__).resolve().parents[1]
+spec=importlib.util.spec_from_file_location('qwen200_nohbm_controller',ROOT/'scripts/benchmark_qwen200.py')
+mod=importlib.util.module_from_spec(spec);spec.loader.exec_module(mod)
+
+
+def status(free=5000):
+    return {'resourceDiagnostics':{'timestamp':'0','sampling':{'age_s':0},'npu':{'npus':[
+        {'index':0,'available':True,'hbm_free_mb':1}, {'index':7,'available':True,'hbm_free_mb':free}]}}}
+
+
+def records():return [dict(status='running') for _ in range(6)]
+
+
+def args(**changes):
+    value=dict(url='http://127.0.0.1:18083',mode='A',concurrency=6,expected_requests=6,
+               diagnostic_wall_timeout_s=.2,target_s=.1,no_progress_s=120,monitor_interval_s=.002,
+               diagnostic_window_s=.005,enable_eta_stop=False,disable_hbm_free_stop=True,
+               startup_resource_interval_s=.01,startup_timeout_s=1)
+    value.update(changes);return argparse.Namespace(**value)
+
+
+def test_cli_flag_is_explicit_default_false_and_keeps_other_limits():
+    base=['--manifest','x','--output','x','--mode','A','--concurrency','6','--expected-requests','6']
+    default=mod.parse_args(base);explicit=mod.parse_args([*base,'--disable-hbm-free-stop'])
+    assert default.disable_hbm_free_stop is False and explicit.disable_hbm_free_stop is True
+    assert explicit.target_s==200 and explicit.diagnostic_wall_timeout_s==336
+    assert explicit.no_progress_s==120 and explicit.shutdown_timeout_s==210 and explicit.observe_s==5
+
+
+def test_default_low_hbm_still_red_but_flag_only_disables_that_condition():
+    enabled=Qwen200Watchdog(0,clock=lambda:1,expected_requests=6)
+    assert enabled.sample(records(),status()).reason=='resource_hbm_free'
+    disabled=Qwen200Watchdog(0,clock=lambda:1,expected_requests=6,disable_hbm_free_stop=True)
+    assert disabled.sample(records(),status()) is None
+    assert disabled.latest_resource['hbm_free_mb']==5000
+    assert disabled.latest_resource['hbm_free_stop_enabled'] is False
+    assert disabled.latest_resource['effective_hbm_free_threshold_mb'] is None
+    assert disabled.latest_resource['configured_hbm_free_threshold_mb']==8192
+
+
+@pytest.mark.parametrize('bad',['false',1,None])
+def test_flag_requires_real_bool(bad):
+    with pytest.raises(ValueError):Qwen200Watchdog(0,disable_hbm_free_stop=bad)
+
+
+def test_threshold_legality_is_preserved_even_when_disabled():
+    with pytest.raises(ValueError):Qwen200Watchdog(0,min_hbm_free_mb=-1,disable_hbm_free_stop=True)
+
+
+@pytest.mark.parametrize('condition,reason',[
+    ('failed','resource_qwen_failure'),('execution','resource_qwen_failure'),
+    ('dead','resource_owned_worker_dead'),('host','resource_host_available')])
+def test_other_resource_or_worker_failures_remain_active(condition,reason):
+    s=status()
+    if condition=='failed':s['qwenModel']={'failed_instances':1}
+    elif condition=='execution':s['qwenModel']={'execution_failures':1}
+    elif condition=='dead':s['qwenModel']={'model_workers':[{'started':True,'worker_alive':False}]}
+    else:s['resourceDiagnostics']['host']={'available':True,'available_bytes':1}
+    w=Qwen200Watchdog(0,clock=lambda:1,expected_requests=6,disable_hbm_free_stop=True)
+    assert w.sample(records(),s).reason==reason
+
+
+def test_swap_still_stops_under_disabled_hbm():
+    now=[0];w=Qwen200Watchdog(0,clock=lambda:now[0],expected_requests=6,disable_hbm_free_stop=True)
+    trigger=None
+    for i in range(4):
+        now[0]=i;s=status();s['resourceDiagnostics']['timestamp']=str(i)
+        s['resourceDiagnostics']['vmstat']={'available':True,'swap_in_bytes':i,'swap_out_bytes':0}
+        trigger=w.sample(records(),s)
+    assert trigger.reason=='resource_sustained_swap'
+
+
+@pytest.mark.parametrize('elapsed,reason',[(120,'no_progress'),(336,'batch_hard_deadline')])
+def test_no_progress_and_hard336_cannot_be_disabled(elapsed,reason):
+    now=[0];w=Qwen200Watchdog(0,clock=lambda:now[0],expected_requests=6,disable_hbm_free_stop=True)
+    assert w.sample(records(),status()) is None
+    now[0]=elapsed;assert w.sample(records(),status()).reason==reason
+
+
+def test_failed_request_oom_signal_not_hidden():
+    r=records();r[0]['status']='failed'
+    w=Qwen200Watchdog(0,clock=lambda:1,expected_requests=6,disable_hbm_free_stop=True)
+    assert w.sample(r,status()).reason=='request_failed'
+
+
+class Owner:
+    def __init__(self,p):self.startup_stop_path=str(p/'stop.json');self.process=SimpleNamespace(poll=lambda:None);self.expected_exit_codes=(0,)
+    def register(self):pass
+
+
+def test_startup_flag_skips_only_free_threshold_and_retains_observation(tmp_path):
+    owner=Owner(tmp_path)
+    async def ready():return {'ready':True}
+    result=asyncio.run(mod.wait_for_startup(args(),owner,tmp_path,
+        probe_fn=lambda:dict(available=True,card=7,free_hbm_mb=5000),status_fn=ready))
+    assert result['ready'] and not Path(owner.startup_stop_path).exists()
+    rows=[json.loads(line) for line in(tmp_path/'startup-resource.jsonl').read_text().splitlines()]
+    assert rows and all(r['free_hbm_mb']==5000 and r['hbm_free_stop_enabled'] is False
+                        and r['threshold_hbm_free_mb'] is None and r['configured_hbm_free_threshold_mb']==8192 for r in rows)
+
+
+def test_startup_unknown_still_fails_closed_with_flag(tmp_path):
+    owner=Owner(tmp_path)
+    async def ready():return {'ready':True}
+    with pytest.raises(mod.StartupResourceAbort) as caught:
+        asyncio.run(mod.wait_for_startup(args(),owner,tmp_path,
+            probe_fn=lambda:dict(available=False,card=7,reason='unobservable'),status_fn=ready))
+    assert caught.value.trigger['reason']=='startup_resource_unobservable'
+    assert Path(owner.startup_stop_path).exists() and owner.expected_exit_codes==(0,)
+
+
+@pytest.mark.parametrize('disabled,should_complete',[(False,False),(True,True)])
+def test_warmup_flag_propagates_through_all_six_real_entry_shapes(monkeypatch,tmp_path,disabled,should_complete):
+    manifest=tmp_path/'six.json';manifest.write_text(json.dumps([dict(path='/not-read',upload_filename=f'audio-{i}.wav') for i in range(6)]))
+    async def warmup_one(*a,**kw):return dict(complete=True,status='completed',elapsed_s=1,last_status=status())
+    monkeypatch.setattr(mod,'warmup_one',warmup_one)
+    result=asyncio.run(mod.warmup(args(warmup_manifest=str(manifest),expected_qwen_workers=None,
+                                      disable_hbm_free_stop=disabled),tmp_path))
+    assert result['complete'] is should_complete
+    assert len(result['records'])==(6 if disabled else 1)
+    assert result['hbm_free_stop_enabled'] is (not disabled)
+    assert result['records'][0]['resource_observation']['hbm_free_stop_enabled'] is (not disabled)
+
+
+def test_warmup_worker_failure_remains_fatal_with_flag(monkeypatch,tmp_path):
+    manifest=tmp_path/'six.json';manifest.write_text(json.dumps([dict(path='/not-read',upload_filename=f'audio-{i}.wav') for i in range(6)]))
+    s=status();s['qwenModel']={'failed_instances':1}
+    async def warmup_one(*a,**kw):return dict(complete=True,status='completed',elapsed_s=1,last_status=s)
+    monkeypatch.setattr(mod,'warmup_one',warmup_one)
+    result=asyncio.run(mod.warmup(args(warmup_manifest=str(manifest),expected_qwen_workers=None),tmp_path))
+    assert not result['complete'] and result['records'][0]['resource_trigger'][0]=='resource_qwen_failure'
+
+
+@pytest.mark.parametrize('disabled,should_complete',[(False,False),(True,True)])
+def test_formal_constructor_receives_flag(monkeypatch,tmp_path,disabled,should_complete):
+    async def request(sample,fields):
+        await asyncio.sleep(.04);return {'segments':[{'segment_text':'真实入口替身'}]}
+    async def get_status():return status()
+    samples=[dict(sample_id=str(i),sha256=str(i),audio_seconds=1,path='/not-read') for i in range(6)]
+    result=asyncio.run(mod.run_round(args(disable_hbm_free_stop=disabled),samples,tmp_path,
+                                   request_fn=request,status_fn=get_status))
+    assert result['complete'] is should_complete and result['hbm_free_stop_enabled'] is (not disabled)
+    if disabled:assert result['processed_completed']==6
+    else:assert result['diagnostic_trigger']['reason']=='resource_hbm_free'
