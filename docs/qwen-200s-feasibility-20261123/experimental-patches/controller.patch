+def experiment_asset_identity(args, samples):
+    files={'controller':Path(__file__).resolve(), 'manifest':Path(args.manifest).resolve()}
+    for name in ('config','warmup_manifest','warmup_audio'):
+        value=getattr(args,name,None)
+        if value:files[name]=Path(value).resolve()
+    if getattr(args,'warmup_manifest',None):
+        for index,row in enumerate(json.loads(Path(args.warmup_manifest).read_text())):
+            files['warmup_clip_'+str(index)]=Path(row['path']).resolve()
+    result={name:{'path':str(path),'sha256':hashlib.sha256(path.read_bytes()).hexdigest()}
+            for name,path in files.items()}
+    result['formal_source_stats']={row['sample_id']:{'path':row['path'],'sha256_verified_before_run':row['sha256'],
+        'stat':list((lambda st:(st.st_size,st.st_mtime_ns,st.st_ino))(Path(row['path']).stat()))} for row in samples}
+    return result
+
+
+def main():
+    args = parse_args()
+    samples = load_samples(args.manifest)
+    output = Path(args.output).resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    identity=source_identity()
+    asset_identity=experiment_asset_identity(args,samples)
+    write_json(output / "run.json", {"arguments": vars(args), "samples": samples, "utc": utc_now(),"source_identity":identity,
+        "experiment_asset_identity":asset_identity,
+        "controller_sha256":hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "prediction_rule_version":RULE_VERSION, "validation_scope":"real eight HTTP, not component throughput",
+        "experiment_environment":{k:v for k,v in os.environ.items() if k.startswith("QWEN200_")}})
+    if args.config:
+        import shutil
+        shutil.copy2(args.config, output / "config.toml")
+    async def run():
+        task = asyncio.current_task()
+        loop = asyncio.get_running_loop()
+        for sig in (signal.SIGINT, signal.SIGTERM):
+            loop.add_signal_handler(sig, task.cancel)
+        return await execute(args, samples, output)
+    exit_code=2
+    try:
+        if not identity["complete"]:
+            raise RuntimeError("实际运行时代码身份未完整记录，拒绝启动测试服务")
+        summary = asyncio.run(run())
+        exit_code=0 if summary["complete"] else 2
+    except BaseException as exc:
+        write_json(output / "runner-error.json", {"error": repr(exc), "utc": utc_now()})
+    finally:
+        if finish_source_identity(output,identity):
+            exit_code=2
+        try:
+            after_assets=experiment_asset_identity(args,samples)
+            asset_changes=[key for key in asset_identity if asset_identity[key]!=after_assets.get(key)]
+        except Exception as exc:
+            after_assets={'identity_error':repr(exc)};asset_changes=['identity_unavailable']
+        run_record=json.loads((output/'run.json').read_text())
+        run_record.update(experiment_asset_identity_after=after_assets,experiment_asset_changes=asset_changes)
+        write_json(output/'run.json',run_record)
+        if asset_changes:
+            exit_code=2
+            if (output/'summary.json').exists():
+                summary=json.loads((output/'summary.json').read_text())
+                summary.update(complete=False,target_passed=False,status='experiment_asset_changed',experiment_asset_changes=asset_changes)
+                write_json(output/'summary.json',summary)
+    return exit_code
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
