+def parse_args(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--manifest", required=True)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--url", default="http://127.0.0.1:18083")
+    parser.add_argument("--concurrency", type=int, choices=(1, 2, 4, 8), required=True)
+    parser.add_argument("--mode", choices=("A", "B", "mixed", "mixed-swap"), required=True)
+    parser.add_argument("--launch-service", action="store_true")
+    parser.add_argument("--config")
+    parser.add_argument("--owned-request-drain-grace-s", type=int, default=30,
+                        help="owned测试HTTP请求drain秒数(1～180)；不改模型/业务超时或cleanup期限")
+    parser.add_argument("--warmup-audio", help="独立真实短片路径；预热不计入八文件正式轮次")
+    parser.add_argument("--warmup-manifest", help="八个真实短clip的path/upload_filename清单，单列于正式计时")
+    parser.add_argument("--warmup-only", action="store_true", help="仅真实HTTP准入检查，不产生性能结论")
+    parser.add_argument("--expected-qwen-workers", type=int, default=1)
+    parser.add_argument("--target-s", type=float, default=200)
+    parser.add_argument("--enable-eta-stop", action="store_true", help="仅充分验证可信证据后启用；缺证据永不ETA早停")
+    parser.add_argument("--expected-model-instances", type=int, help="可选预热后健康容量校验；A只校验VAD，不要求增强加载")
+    for name, default in (("diagnostic-wall-timeout-s",336), ("monitor-interval-s",1),
+                          ("no-progress-s",120), ("diagnostic-window-s",5),
+                          ("shutdown-timeout-s",210), ("startup-timeout-s",300), ("observe-s",5)):
+        parser.add_argument("--"+name, type=float, default=default)
+    args = parser.parse_args(argv)
+    import math
+    for name in ("diagnostic_wall_timeout_s", "monitor_interval_s", "no_progress_s", "diagnostic_window_s", "shutdown_timeout_s", "startup_timeout_s", "observe_s"):
+        if not math.isfinite(getattr(args,name)) or getattr(args,name) <= 0:
+            parser.error(f"{name}必须为有限正值")
+    if not 1 <= args.owned_request_drain_grace_s <= 180:
+        parser.error("owned request drain grace必须是1～180秒整数")
+    if args.observe_s < 5 or args.diagnostic_wall_timeout_s > 336:
+        parser.error("不得放宽336秒门槛或缩短5秒端口观察")
+    if args.mode != "A" or args.concurrency != 8:
+        parser.error("本实验必须原八完整WAV、A模式、八HTTP并发")
+    if not math.isfinite(args.target_s) or not 0 < args.target_s <= 200 or args.target_s >= args.diagnostic_wall_timeout_s:
+        parser.error("目标必须为有限正值且不得放宽200秒")
+    if args.expected_qwen_workers < 1 or args.expected_qwen_workers > 8:
+        parser.error("expected-qwen-workers须1～8")
+    if args.warmup_only and not (args.warmup_manifest or args.warmup_audio):
+        parser.error("warmup-only需要真实短clip")
+    if args.launch_service and not args.config:
+        parser.error("owned服务启动必须指定--config")
+    if args.launch_service and args.shutdown_timeout_s < 210:
+        parser.error("owned关闭期限至少210秒以保留真实资源收尾余量，独立于HTTP request drain grace")
+    if args.expected_model_instances is not None and (args.expected_model_instances < 1 or not (args.warmup_audio or args.warmup_manifest)):
+        parser.error("expected-model-instances需正整数并同时指定warmup-audio")
+    return args
+
