@@ -0,0 +1,195 @@
+"""独立200秒验证的全轮闸门；预测是经验估计，不是硬件下界。"""
+from __future__ import annotations
+
+from dataclasses import asdict
+import math
+import time
+from core.performance_watchdog import DiagnosticTrigger, percentile
+
+
+RULE_VERSION = 'qwen200-v1-report-only-20261123'
+
+
+def finite(value):
+    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)
+
+
+def extract_progress(status):
+    active = status.get('resourceDiagnostics', {}).get('requestTelemetry', {}).get('active', {})
+    result = {}
+    for row in active.get('requests', []):
+        progress = row.get('progress', {})
+        total, done = progress.get('segments_total'), progress.get('qwen_done', 0)
+        key = row.get('request_id')
+        if key and type(total) is int and total > 0 and type(done) is int and 0 <= done <= total:
+            result[str(key)] = {'total': total, 'done': done, 'inflight': None,
+                                'stage': row.get('stage')}
+    return result
+
+
+class Qwen200Watchdog:
+    def __init__(self, started, *, clock=time.monotonic, hard_s=336.0, target_s=200.0,
+                 no_progress_s=120.0, enable_eta_stop=False, min_hbm_free_mb=8192.0,
+                 min_host_available_bytes=16*1024**3, expected_requests=8):
+        if not all(finite(v) and v > 0 for v in (hard_s, target_s, no_progress_s, min_hbm_free_mb)):
+            raise ValueError('验证门槛必须为有限正数')
+        if hard_s > 336 or target_s > 200 or target_s >= hard_s:
+            raise ValueError('不得放宽200目标或336硬截止')
+        self.started, self.clock, self.hard_s, self.target_s = started, clock, hard_s, target_s
+        self.no_progress_s, self.enable_eta_stop = no_progress_s, bool(enable_eta_stop)
+        self.min_hbm_free_mb = min_hbm_free_mb
+        self.min_host_available_bytes = min_host_available_bytes
+        self.expected_requests = expected_requests
+        self.trigger = None
+        self.last_progress = started
+        self.last_token = None
+        self.history, self.fastest = [], {}
+        self.last_eval = -math.inf
+        self.previous_resource_stamp = None
+        self.swap_previous = None
+        self.swap_streak = 0
+        self.eta_streak = 0
+        self.predictions = []
+        self.latest_resource = {}
+
+    def _trigger(self, reason, now, observed, threshold):
+        self.trigger = DiagnosticTrigger(reason, now, None, observed, threshold)
+        return self.trigger
+
+    def resource_sample(self, status):
+        diag = status.get('resourceDiagnostics', {})
+        stamp = diag.get('timestamp')
+        age = diag.get('sampling', {}).get('age_s')
+        resources = {'driver_card': 7, 'hbm_free_mb': None, 'host_available_bytes': None,
+                     'resource_age_s': age, 'sample_timestamp': stamp, 'swap_streak': self.swap_streak}
+        # 其它卡的高占用与本轮无关；过旧快照只标未知，不拿来触发红线。
+        if finite(age) and age > 15:
+            resources['unknown_reason'] = 'stale_resource_snapshot'
+            return resources, None
+        for npu in diag.get('npu', {}).get('npus', []):
+            if npu.get('index') == 7 and npu.get('available'):
+                free = npu.get('hbm_free_mb')
+                if finite(free): resources['hbm_free_mb'] = free
+        host = diag.get('host', {})
+        if host.get('available') and finite(host.get('available_bytes')):
+            resources['host_available_bytes'] = host['available_bytes']
+        if resources['hbm_free_mb'] is not None and resources['hbm_free_mb'] < self.min_hbm_free_mb:
+            return resources, ('resource_hbm_free', resources['hbm_free_mb'], self.min_hbm_free_mb)
+        if resources['host_available_bytes'] is not None and resources['host_available_bytes'] < self.min_host_available_bytes:
+            return resources, ('resource_host_available', resources['host_available_bytes'], self.min_host_available_bytes)
+        vm = diag.get('vmstat', {})
+        if vm.get('available') and stamp is not None and stamp != self.previous_resource_stamp:
+            current = tuple(vm.get(k) for k in ('swap_in_bytes', 'swap_out_bytes'))
+            if all(finite(v) for v in current):
+                if self.swap_previous is not None and any(a > b for a, b in zip(current, self.swap_previous)):
+                    self.swap_streak += 1
+                else:
+                    self.swap_streak = 0
+                self.swap_previous = current
+            self.previous_resource_stamp = stamp
+        resources['swap_streak'] = self.swap_streak
+        if self.swap_streak >= 3:
+            return resources, ('resource_sustained_swap', self.swap_streak, 3)
+        qwen = status.get('qwenModel', {})
+        if qwen.get('failed_instances', 0) or qwen.get('execution_failures', 0):
+            return resources, ('resource_qwen_failure', 1, 0)
+        for worker in qwen.get('model_workers', []):
+            if worker.get('started') and worker.get('worker_alive') is False:
+                return resources, ('resource_owned_worker_dead', 1, 0)
+        return resources, None
+
+    def _prediction(self, now, progress, records, status):
+        elapsed = now-self.started
+        report = {'rule_version': RULE_VERSION, 'elapsed_s': elapsed, 'progress': progress,
+                  'eta_total_s': None, 'per_request': {}, 'trusted': False, 'reasons': [],
+                  'rate_acceleration_allowance': 1.25, 'enabled_for_stop': self.enable_eta_stop,
+                  'scope': 'empirical optimistic projection, not observed completion time or hardware lower bound',
+                  'audio_duration_distribution': None, 'generated_token_distribution': None,
+                  'tail_acceleration_assumption': 'requires separate comparable distribution/shared-load/tail evidence'}
+        if elapsed < 90: report['reasons'].append('startup_or_short_elapsed')
+        if len(progress) != self.expected_requests: report['reasons'].append('all_eight_live_progress_not_available')
+        if len(self.history) < 2 or now-self.history[0][0] < 60:
+            report['reasons'].append('less_than_60s_progress')
+        for key, value in progress.items():
+            rates = []
+            for window in (30, 60):
+                candidates = [(t, values[key]) for t, values in self.history
+                              if key in values and t <= now-window]
+                if not candidates:
+                    rates.append(None)
+                    continue
+                t, old = candidates[-1]
+                rate = (value['done']-old['done'])/(now-t)
+                if value['total'] != old['total'] or rate < 0:
+                    report['reasons'].append('non_monotonic_progress_or_changed_total')
+                    rate = None
+                rates.append(rate)
+            valid = [r for r in rates if r is not None and r > 0]
+            self.fastest[key] = max([self.fastest.get(key, 0), *valid])
+            optimistic_rate = self.fastest[key]*1.25
+            eta = elapsed+(value['total']-value['done'])/optimistic_rate if optimistic_rate else None
+            report['per_request'][key] = dict(value, rate30= rates[0], rate60=rates[1],
+                fastest_comparable_rate=self.fastest[key], optimistic_rate=optimistic_rate, eta_total_s=eta)
+            if eta is None: report['reasons'].append('zero_or_unknown_rate')
+        known = [row['eta_total_s'] for row in report['per_request'].values()]
+        if known and all(v is not None for v in known): report['eta_total_s'] = max(known)
+        # 单靠已完成段数不能证明后续自然段难度和尾部释放。默认只报告，不能早停。
+        evidence = status.get('qwen200_eta_evidence', {})
+        for field in ('distribution_comparable', 'shared_load_stable', 'tail_acceleration_modeled'):
+            if evidence.get(field) is not True: report['reasons'].append(field+'_not_verified')
+        report['reasons'] = sorted(set(report['reasons']))
+        report['trusted'] = not report['reasons']
+        return report
+
+    def sample(self, records, status):
+        if self.trigger: return self.trigger
+        now = self.clock()
+        elapsed = now-self.started
+        incomplete = any(row['status'] != 'completed' for row in records)
+        # 全轮共同起点，不能等每条请求自己的起点再多跑几秒。
+        if elapsed >= self.hard_s and incomplete:
+            return self._trigger('batch_hard_deadline', now, elapsed, self.hard_s)
+        if any(row['status'] == 'failed' for row in records):
+            return self._trigger('request_failed', now, 1, 0)
+        self.latest_resource, red = self.resource_sample(status)
+        if red: return self._trigger(red[0], now, red[1], red[2])
+        progress = extract_progress(status)
+        steps = []
+        for instance in status.get('qwenModel', {}).get('instances', []):
+            step = instance.get('continuous', {}).get('steps', {})
+            steps.append((step.get('prefill'), step.get('decode')))
+        token = (tuple(sorted((key, v['total'], v['done']) for key, v in progress.items())),
+                 tuple(row['status'] for row in records), tuple(steps))
+        if token != self.last_token:
+            self.last_token, self.last_progress = token, now
+        elif incomplete and now-self.last_progress >= self.no_progress_s:
+            return self._trigger('no_progress', now, now-self.last_progress, self.no_progress_s)
+        if progress and (not self.history or now > self.history[-1][0]):
+            self.history.append((now, progress))
+            self.history = self.history[-600:]
+        if elapsed >= 90 and now-self.last_eval >= 30:
+            self.last_eval = now
+            report = self._prediction(now, progress, records, status)
+            self.predictions.append(report)
+            if report['trusted'] and report['eta_total_s'] is not None and report['eta_total_s'] >= self.hard_s:
+                self.eta_streak += 1
+            else: self.eta_streak = 0
+            report['consecutive_insufficient_windows'] = self.eta_streak
+            if self.enable_eta_stop and self.eta_streak >= 2:
+                return self._trigger('optimistic_eta_insufficient', now, report['eta_total_s'], self.hard_s)
+        return None
+
+
+def add_feasibility_summary(summary, target_s=200):
+    complete = bool(summary.get('complete')) and summary.get('processed_completed') == summary.get('expected')
+    summary['target_s'] = target_s
+    summary['hard_deadline_s'] = 336
+    summary['target_time_met_before_cleanup'] = complete and summary['batch_elapsed_s'] <= target_s
+    summary['target_passed'] = summary['target_time_met_before_cleanup']
+    summary['all_request_latency'] = dict(summary['completion_subset_latency']) if complete else None
+    summary['exact_end_to_end_speedup'] = None
+    summary['speedup_scope'] = 'requires a complete paired reference; censored/ETA values are never speedup denominators'
+    summary['completed_subset_only'] = not complete
+    summary['classification'] = ('time_target_met_quality_unreviewed' if summary['target_time_met_before_cleanup']
+                                 else 'completed_above_target' if complete else 'stopped_or_incomplete')
+    return summary
