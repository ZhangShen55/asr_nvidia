+def write_json(path, value):
+    path = Path(path)
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    # 历史源文件名可能包含surrogateescape，JSON转义保留原字节往返能力。
+    temporary.write_text(json.dumps(value, ensure_ascii=True, indent=2) + "\n")
+    temporary.replace(path)
