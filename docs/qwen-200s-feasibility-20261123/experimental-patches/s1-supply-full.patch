+"""S1实验专用有界发送与裁剪供给；不改变模型生成或段窗口。"""
+from __future__ import annotations
+import atexit
+import asyncio
+from collections import deque
+from concurrent.futures import ThreadPoolExecutor, Future
+import contextvars
+import os
+import threading
+import time
+import weakref
+from core.async_utils import await_completion
+
+
+class OwnedCommandSender:
+    """唯一发送线程保持FIFO；data不能占用cancel/release/close的预留空间。"""
+    def __init__(self, send, failure, capacity):
+        self.send=send;self.failure=failure;self.capacity=capacity
+        self.cv=threading.Condition();self.items=deque();self.stopped=False
+        self.queued_data=0;self.controls=set();self.close_queued=False
+        self.metrics=dict(sent=0,queued_bytes=0,max_queued=0,queue_wait_s=0.0,send_wall_s=0.0)
+        self.thread=threading.Thread(target=self._run,name='qwen-owned-fifo-sender',daemon=False)
+        self.thread.start()
+
+    def enqueue(self, message, *, confirm=False):
+        op=message['operation'];data=op=='submit'
+        token=(op,tuple(message['key']) if op=='cancel' else message.get('request_id'))
+        with self.cv:
+            if self.stopped:raise RuntimeError('owned sender stopped')
+            if self.close_queued:
+                if op in ('close','cancel','release_request'):return False
+                raise RuntimeError('owned sender closing')
+            if not data and token in self.controls:return False
+            if (data and self.queued_data>=self.capacity) or len(self.items)>=3*self.capacity+16:
+                raise BufferError('owned command queue full before acceptance')
+            if op=='close':self.close_queued=True
+            if not data:self.controls.add(token)
+            if data:self.queued_data+=1
+            ticket=Future() if confirm else None
+            self.items.append((message,time.monotonic(),token,ticket))
+            self.metrics['queued_bytes']+=len(message.get('audio',b''))
+            self.metrics['max_queued']=max(self.metrics['max_queued'],len(self.items))
+            self.cv.notify()
+            return ticket if confirm else True
+
+    def _run(self):
+        try:
+            while True:
+                with self.cv:
+                    while not self.items and not self.stopped:self.cv.wait()
+                    if self.stopped:return
+                    message,queued,token,ticket=self.items.popleft()
+                    if message['operation']=='submit':self.queued_data-=1
+                    else:self.controls.discard(token)
+                    self.metrics['queued_bytes']-=len(message.get('audio',b''))
+                    self.metrics['queue_wait_s']+=time.monotonic()-queued
+                start=time.monotonic()
+                try:self.send(message)
+                except BaseException as exc:
+                    if ticket is not None:
+                        ticket.set_exception(exc)
+                        # release的原同步错误交回调用者，不覆盖其原始请求错误。
+                        if message['operation']=='release_request':continue
+                    raise
+                if ticket is not None:ticket.set_result(True)
+                with self.cv:
+                    self.metrics['send_wall_s']+=time.monotonic()-start
+                    self.metrics['sent']+=1
+                if message['operation']=='close':return
+        except BaseException as exc:
+            self.stop()
+            self.failure(exc)
+
+    def stop(self):
+        with self.cv:
+            self.stopped=True
+            for _,_,_,ticket in self.items:
+                if ticket is not None and not ticket.done():ticket.set_exception(RuntimeError('owned sender stopped'))
+            self.items.clear();self.queued_data=0;self.controls.clear()
+            self.metrics['queued_bytes']=0;self.cv.notify_all()
+
+    def join(self,timeout):
+        if threading.current_thread() is not self.thread:self.thread.join(timeout)
+        return not self.thread.is_alive()
+
+    def snapshot(self):
+        with self.cv:return dict(self.metrics,queued_commands=len(self.items),queued_data=self.queued_data,
+            sender_alive=self.thread.is_alive(),stopped=self.stopped,close_queued=self.close_queued)
+
+
+_pool=None
+_pool_lock=threading.Lock()
+_slots=weakref.WeakKeyDictionary()
+_cut_metrics=dict(calls=0,queue_wait_s=0.0,work_s=0.0)
+
+
+def _cut_limits():
+    workers=int(os.environ.get('QWEN200_CUT_THREADS','4'))
+    capacity=int(os.environ.get('QWEN200_CUT_CAPACITY','128'))
+    if not 1<=workers<=128 or not workers<=capacity<=1024:raise ValueError('invalid S1 cut bounds')
+    return workers,capacity
+
+
+async def run_cut_in_thread(function, /, *args, **kwargs):
+    """仅裁剪使用此pool；取消仍等待实际线程终态才释放有界名额。"""
+    global _pool
+    loop=asyncio.get_running_loop();workers,capacity=_cut_limits()
+    with _pool_lock:
+        if _pool is None:_pool=ThreadPoolExecutor(max_workers=workers,thread_name_prefix='qwen-cut')
+        semaphore=_slots.setdefault(loop,asyncio.BoundedSemaphore(capacity))
+        pool=_pool
+    await semaphore.acquire()
+    try:
+        context=contextvars.copy_context();queued=time.monotonic()
+        def run():
+            began=time.monotonic()
+            with _pool_lock:_cut_metrics['queue_wait_s']+=began-queued
+            try:return context.run(function,*args,**kwargs)
+            finally:
+                with _pool_lock:
+                    _cut_metrics['calls']+=1;_cut_metrics['work_s']+=time.monotonic()-began
+        return await await_completion(asyncio.wrap_future(pool.submit(run),loop=loop))
+    finally:semaphore.release()
+
+
+def cut_executor_snapshot():
+    with _pool_lock:return dict(_cut_metrics,workers=_cut_limits()[0],capacity=_cut_limits()[1])
+
+
+def close_cut_executor():
+    global _pool
+    with _pool_lock:pool=_pool;_pool=None
+    if pool is not None:pool.shutdown(wait=True)
+
+
+atexit.register(close_cut_executor)
