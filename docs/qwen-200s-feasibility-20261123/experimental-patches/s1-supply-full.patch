+"""S1真实Pipe/独立裁剪池CPU契约；无权重或设备执行。"""
+import asyncio
+from concurrent.futures import ThreadPoolExecutor
+import multiprocessing
+import threading
+import time
+from types import SimpleNamespace
+import pytest
+from core.qwen_asr_process import _send,_receive,_identity,QwenWorkerUnavailableError
+from core.qwen_continuous_process import LocalQwenContinuousProcessRuntime
+from core.qwen_continuous_runtime import ContinuousCapacityRejected
+from core.qwen200_supply import OwnedCommandSender,run_cut_in_thread,close_cut_executor
+
+
+def echo_worker(connection,launch_id,pause):
+    held=set()
+    try:
+        pause.wait(10)
+        while True:
+            message,_=_receive(connection);op=message['operation']
+            if op=='submit':
+                key=tuple(message['key'])
+                if key[1]=='held':held.add(key)
+                else:_send(connection,dict(kind='result',launch_id=launch_id,key=key,result={'text':'ok'}))
+            elif op=='cancel':
+                key=tuple(message['key'])
+                if key in held:
+                    held.remove(key)
+                    _send(connection,dict(kind='result',launch_id=launch_id,key=key,result={'error':dict(
+                        type='ContinuousGenerationError',message='cancelled',reason='cancelled',
+                        request_id=key[0],segment_id=key[1])}))
+            elif op=='close':
+                assert not held
+                _send(connection,dict(kind='closed',launch_id=launch_id,state={}))
+                return
+    finally:connection.close()
+
+
+def pipe_runtime(pause=True,capacity=16):
+    context=multiprocessing.get_context('spawn');parent,child=context.Pipe();ready=context.Event()
+    if not pause:ready.set()
+    runtime=LocalQwenContinuousProcessRuntime('/tmp/no-s1-model','npu:7',max_active=capacity,
+        _close_timeout_s=4,_abort_timeout_s=2)
+    process=context.Process(target=echo_worker,args=(child,runtime._launch_id,ready));process.start();child.close()
+    runtime._process=process;runtime._connection=parent;runtime._owned_identity=_identity(process.pid)
+    runtime._accept_state=lambda _:None
+    runtime._reader=threading.Thread(target=runtime._read_continuous,name='s1-test-reader')
+    runtime._reader.start()
+    return runtime,process,parent,ready
+
+
+def finish(runtime,process,parent):
+    if process.is_alive():
+        runtime.begin_closing();runtime.abort_owned('test cleanup')
+    process.join(3)
+    if runtime._sender is not None:
+        runtime._sender.stop();assert runtime._sender.join(3)
+    runtime._reader.join(3);parent.close()
+    assert not process.is_alive() and not runtime._reader.is_alive()
+
+
+def test_runtime_fifo_dedup_capacity_control_reserve_cancel_release_and_close():
+    runtime,process,parent,ready=pipe_runtime()
+    try:
+        held=runtime.submit(b'x'*262144,request_id='a',segment_id='held')
+        assert runtime.submit(b'z',request_id='a',segment_id='held') is held
+        futures=[runtime.submit(b'x'*262144,request_id='a',segment_id=str(i)) for i in range(15)]
+        rejected=runtime.submit(b'x',request_id='a',segment_id='overflow')
+        assert isinstance(rejected.exception(),ContinuousCapacityRejected)
+        assert rejected.exception().accepted is False
+        with pytest.raises(RuntimeError,match='active'):runtime.release_request('a')
+        runtime.cancel_segment('a','held');runtime.cancel_segment('a','held')
+        ready.set()
+        for future in futures:assert future.result(5)=='ok'
+        assert held.exception(5).reason=='cancelled'
+        runtime.release_request('a')
+        runtime.close();runtime.close()
+        assert not runtime._futures and runtime.snapshot()['model_worker']['normal_exit_ok']
+        assert not runtime._sender.thread.is_alive()
