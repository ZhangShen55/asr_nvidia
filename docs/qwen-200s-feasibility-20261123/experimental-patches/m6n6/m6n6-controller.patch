diff --git a/tests/test_qwen200_six.py b/tests/test_qwen200_six.py
new file mode 100644
--- /dev/null
+++ b/tests/test_qwen200_six.py
@@ -0,0 +1,135 @@
+"""明确六输入的实验控制器契约；八输入仍为默认，替身不代表NPU性能。"""
+import argparse
+import asyncio
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import pytest
+from core.qwen200_watchdog import Qwen200Watchdog
+
+ROOT=Path(__file__).resolve().parents[1]
+spec=importlib.util.spec_from_file_location('qwen200_six_controller',ROOT/'scripts/benchmark_qwen200.py')
+mod=importlib.util.module_from_spec(spec);spec.loader.exec_module(mod)
+
+
+def cli(*extra):
+    return ['--manifest','unused','--output','unused','--mode','A','--concurrency','6',
+            '--expected-requests','6','--expected-qwen-workers','6',*extra]
+
+
+def records(state='running'):
+    return [dict(sample_id=str(i),status=state,audio_seconds=1) for i in range(6)]
+
+
+def samples():
+    return [dict(sample_id=str(i),sha256=str(i),audio_seconds=1,path='/not-read') for i in range(6)]
+
+
+def args(**override):
+    values=dict(url='http://127.0.0.1:18083',mode='A',concurrency=6,expected_requests=6,
+                diagnostic_wall_timeout_s=.1,target_s=.01,no_progress_s=120,
+                monitor_interval_s=.002,diagnostic_window_s=.005,enable_eta_stop=False)
+    values.update(override);return argparse.Namespace(**values)
+
+
+def test_explicit_six_cli_keeps_goal_resource_cleanup_and_startup_boundaries():
+    a=mod.parse_args(cli('--startup-timeout-s','600','--warmup-manifest','six.json'))
+    assert a.expected_requests==a.concurrency==a.expected_qwen_workers==6
+    assert a.target_s==200 and a.diagnostic_wall_timeout_s==336
+    assert a.owned_request_drain_grace_s==30 and a.shutdown_timeout_s==210 and a.observe_s==5
+    assert a.startup_resource_interval_s==2 and a.startup_timeout_s==600
+
+
+def test_default_eight_protocol_preserved():
+    a=mod.parse_args(['--manifest','x','--output','x','--mode','A','--concurrency','8'])
+    assert a.expected_requests==a.concurrency==8
+    w=Qwen200Watchdog(0,clock=lambda:0)
+    assert w.expected_requests==8 and w.min_hbm_free_mb==8192
+
+
+@pytest.mark.parametrize('extra',[
+    ['--concurrency','8'],['--mode','B'],['--expected-requests','7'],
+    ['--expected-qwen-workers','8'],['--diagnostic-wall-timeout-s','337'],['--target-s','201']])
+def test_six_cli_rejects_mismatches_or_weakened_rules(extra):
+    with pytest.raises(SystemExit):mod.parse_args(cli(*extra))
+
+
+def test_six_concurrency_is_not_silently_inferred_without_explicit_count():
+    with pytest.raises(SystemExit):
+        mod.parse_args(['--manifest','x','--output','x','--mode','A','--concurrency','6'])
+
+
+def manifest(tmp_path,count):
+    rows=[]
+    for i in range(count):
+        f=tmp_path/f'input-{i}.wav';f.write_bytes(('unique-cpu-fixture-'+str(i)).encode())
+        rows.append(dict(path=str(f),sample_id=str(i),sha256=hashlib.sha256(f.read_bytes()).hexdigest(),audio_seconds=1))
+    p=tmp_path/'manifest.json';p.write_text(json.dumps(rows));return p
+
+
+def test_input_sha_and_exact_count_six_without_truncation(tmp_path):
+    p=manifest(tmp_path,6)
+    assert len(mod.load_samples(p,expected_requests=6))==6
+    with pytest.raises(ValueError,match='8条'):mod.load_samples(p)
+    p=manifest(tmp_path,8)
+    with pytest.raises(ValueError,match='6条'):mod.load_samples(p,expected_requests=6)
+
+
+def test_six_manifest_rejects_changed_sha(tmp_path):
+    p=manifest(tmp_path,6);rows=json.loads(p.read_text())
+    Path(rows[0]['path']).write_bytes(b'changed')
+    with pytest.raises(ValueError,match='SHA'):mod.load_samples(p,expected_requests=6)
+
+
+def test_six_full_completion_quantile_n6_not_n8(tmp_path):
+    async def request(sample,fields):
+        await asyncio.sleep(.02);return {'segments':[{'segment_text':'六路'}],'text':'六路'}
+    async def status():return {}
+    result=asyncio.run(mod.run_round(args(),samples(),tmp_path,request_fn=request,status_fn=status))
+    assert result['complete'] and result['expected']==result['expected_requests']==6
+    assert result['processed_completed']==6 and result['all_request_latency']['n']==6
+    assert result['completion_subset_latency']['n']==6 and result['exact_end_to_end_speedup'] is None
+
+
+def test_six_censored_run_has_no_full_quantiles_and_all_six_started(tmp_path):
+    started=[]
+    async def request(sample,fields):started.append(sample['sample_id']);await asyncio.sleep(10)
+    async def status():return {}
+    result=asyncio.run(mod.run_round(args(diagnostic_wall_timeout_s=.04),samples(),tmp_path,request_fn=request,status_fn=status))
+    assert len(started)==6 and result['expected_requests']==6 and result['processed_completed']==0
+    assert result['all_request_latency'] is None and result['completion_subset_latency']['n']==0
+    assert result['diagnostic_trigger']['reason']=='batch_hard_deadline'
+
+
+def test_six_warmup_matches_explicit_manifest_and_reports_count(tmp_path):
+    p=tmp_path/'six.json';p.write_text(json.dumps([dict(path='/not-read',upload_filename=f'audio-{i}.wav') for i in range(6)]))
+    async def request(source,fields):return {'segments':[],'text':''}
+    async def status():return {}
+    result=asyncio.run(mod.warmup(args(warmup_manifest=str(p),expected_qwen_workers=None),tmp_path,
+                                 request_fn=request,status_fn=status))
+    assert result['complete'] and result['expected_requests']==6 and len(result['records'])==6
+    assert result['kind']=='six_real_http_warmup_clips'
+
+
+def test_six_warmup_rejects_old_eight_manifest_before_any_request(tmp_path):
+    p=tmp_path/'eight.json';p.write_text(json.dumps([dict(path='/not-read',upload_filename=f'audio-{i}.wav') for i in range(8)]))
+    async def request(*a):pytest.fail('invalid count submitted a request')
+    with pytest.raises(ValueError,match='6条'):
+        asyncio.run(mod.warmup(args(warmup_manifest=str(p),expected_qwen_workers=None),tmp_path,request_fn=request))
+
+
+def test_watchdog_six_progress_does_not_require_eight():
+    clock=[0];w=Qwen200Watchdog(0,clock=lambda:clock[0],expected_requests=6)
+    for t in range(0,121,10):
+        clock[0]=t
+        s={'resourceDiagnostics':{'requestTelemetry':{'active':{'requests':[
+            dict(request_id=str(i),stage='segments',progress={'segments_total':100,'qwen_done':t//10}) for i in range(6)]}}}}
+        assert w.sample(records(),s) is None
+    assert w.predictions[-1]['expected_requests']==6
+    assert 'all_expected_live_progress_not_available' not in w.predictions[-1]['reasons']
+
+
+@pytest.mark.parametrize('bad',[True,5,None])
+def test_watchdog_expected_count_is_strict(bad):
+    with pytest.raises(ValueError):Qwen200Watchdog(0,expected_requests=bad)
